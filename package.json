{
	"name": "ttrpg-soundboard",
	"version": "1.0.1",
	"private": true,
	"description": "Local soundboard for Tabletop RPG sessions",
	"keywords": [
		"soundboard",
		"ttrpg",
		"rpg",
		"tabletop",
		"music",
		"sound-effects"
	],
	"license": "Unlicense",
	"author": "Maurycy Zarzycki & Claude",
	"homepage": "https://github.com/EvidentlyCube/ttrpg-soundboard#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EvidentlyCube/ttrpg-soundboard.git"
	},
	"bugs": {
		"url": "https://github.com/EvidentlyCube/ttrpg-soundboard/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=24.14.0"
	},
	"scripts": {
		"start": "node index.js",
		"dev": "node --watch index.js",
		"test": "node --test \"test/backend/**/*.test.js\" \"test/frontend/**/*.test.js\" \"test/helpers/**/*.test.js\" \"test/scripts/**/*.test.js\"",
		"test:browser": "playwright test -c test/browser/playwright.config.js",
		"typecheck": "tsc -p tsconfig.backend.json && tsc -p tsconfig.logic.json && tsc -p tsconfig.ui.json && tsc -p tsconfig.frontend-tests.json && tsc -p tsconfig.browser-tests.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"check": "npm run typecheck && npm run lint && npm test",
		"pack": "node scripts/pack.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.64.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^24.19.2",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"typescript": "^7.0.2"
	}
}
